{
  "type": "object",
  "additionalProperties": false,
  "required": ["pages"],
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "mode", "title", "rationale", "sources", "priority", "audience"],
        "properties": {
          "slug": {"type": "string", "pattern": "^(tutorials|how-to|reference|explanation)/[a-z0-9][a-z0-9/-]*$"},
          "mode": {"enum": ["tutorial", "howto", "reference", "explanation"]},
          "title": {"type": "string"},
          "rationale": {"type": "string"},
          "sources": {"type": "array", "items": {"type": "string"}},
          "priority": {"type": "integer", "minimum": 1, "maximum": 3},
          "audience": {"type": "string"}
        }
      }
    }
  }
}
